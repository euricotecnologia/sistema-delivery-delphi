  object uBuscaPedido: TFDQuery
    Connection = BotDAO.CN
    SQL.Strings = (
      
        'select * from tbl_pedido where pedido_status<>'#39'N'#39' and pedido_imp' +
        '='#39'0'#39' order by pedido_id asc limit 1')
    Left = 400
    Top = 192
    object uBuscaPedidopedido_id: TFDAutoIncField
      FieldName = 'pedido_id'
      Origin = 'pedido_id'
      ProviderFlags = [pfInWhere, pfInKey]
      ReadOnly = True
    end
    object uBuscaPedidopedido_status: TStringField
      AutoGenerateValue = arDefault
      FieldName = 'pedido_status'
      Origin = 'pedido_status'
