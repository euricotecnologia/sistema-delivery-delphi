  object uPedImp: TFDQuery
    Connection = BotDAO.CN
    SQL.Strings = (
      
        'select *,p.pedido_valor_total - sum(i.itemPedido_total) as taxa,' +
        'sum(i.itemPedido_valor) as subtotal from tbl_pedido as p inner j' +
        'oin tbl_itempedido as i where p.pedido_id=i.itemPedido_pedido_id' +
        ' and  p.pedido_id=:id')
    Left = 776
    Top = 190
    ParamData = <
      item
        Name = 'ID'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
